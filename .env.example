VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# GEMINI_API_KEY vai como Supabase Secret (nunca como VITE_ no frontend)
# npx supabase secrets set GEMINI_API_KEY=AIza...

# URL PÚBLICA do painel do Chatwoot (WhatsApp / Atendimento), ex.:
# VITE_CHATWOOT_URL=https://atendimento.seudominio.com.br/app/accounts/1/dashboard
# Somente o endereço https, sem token, senha, ?parâmetros ou #. Tudo que é VITE_ fica público no site.
# Sem esta variável, o item do menu aparece desabilitado.
VITE_CHATWOOT_URL=
